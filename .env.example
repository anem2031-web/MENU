# Application
# Local development: development
# Railway production: production
NODE_ENV=development

# The app uses SERVER_PORT first, then Railway's PORT, then 3001.
SERVER_PORT=3001

# Used only for local Vite development. In production Web + API share one origin.
CLIENT_ORIGIN=http://localhost:5173

# Frontend
# Used only in development. Production always calls the same origin.
VITE_API_URL=http://localhost:3001

# TiDB
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/MENU?ssl={"rejectUnauthorized":true}
TIDB_CA_PATH=

# Admin authentication
# Generate a long random value before production.
AUTH_SECRET=change-this-to-a-long-random-secret

# Used only when running: pnpm --filter @almalqa/server owner:create
OWNER_USERNAME=owner
OWNER_PASSWORD=<SET_LOCALLY>

# IDrive e2 / S3-compatible image storage (Phase 7)
# Keep access keys only in the local .env file. Never commit real secrets.
S3_ENDPOINT=https://YOUR-IDRIVE-E2-ENDPOINT
S3_REGION=eu-central-1
S3_BUCKET=YOUR_BUCKET_NAME
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Public base URL that serves objects from the bucket, without a trailing slash.
# Example shape only: https://PUBLIC-HOST/YOUR_BUCKET
S3_PUBLIC_BASE_URL=https://YOUR-PUBLIC-IMAGE-BASE-URL
# IDrive e2 commonly works with path-style S3 URLs; change to false only if your endpoint requires it.
S3_FORCE_PATH_STYLE=true
